# Chuolingo LMS - Environment Variables Example
# Copy this file to .env.local and fill in the values

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection URL (used by Prisma)
# You can use Supabase Postgres URL here (found in Supabase dashboard → Project Settings → Database)
DATABASE_URL="postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres?schema=public"

# Direct connection URL without the schema suffix (required by Prisma for migrations)
DIRECT_URL="postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# Supabase Auth & Storage
# ------------------------------------------------------------------------------
# Found in Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your_project_ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Service role key (KEEP SECRET, never expose to client)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# ------------------------------------------------------------------------------
# OpenAI / LLM Provider
# ------------------------------------------------------------------------------
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional: specify a custom base URL if using an OpenAI-compatible provider
# OPENAI_BASE_URL="https://api.openai.com/v1"
# Optional: which model to use (default: gpt-4o-mini for speed + cost, use gpt-4o for best quality)
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# App
# ------------------------------------------------------------------------------
# Canonical URL of the deployed app (used for auth redirects, emails, links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Rate Limiting (optional)
# ------------------------------------------------------------------------------
# Upstash Redis REST URL if you want persistent cross-instance rate limits
# If not set, an in-memory rate limiter will be used for single-server setups.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
